<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/matchDetailsFragment">

    <fragment
        android:id="@+id/profileStatFragment"
        android:name="com.example.loltracker.ui.ProfileStatFragment"
        android:label="fragment_profile_stat"
        tools:layout="@layout/fragment_profile_stat" >
        <argument
            android:name="account"
            app:argType="string" />
        <argument
            android:name="puuid"
            app:argType="string" />
        <argument
            android:name="profileIconId"
            app:argType="integer" />
        <argument
            android:name="summonerLevel"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.loltracker.ui.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_profileStatFragment"
            app:destination="@id/profileStatFragment" />
        <action
            android:id="@+id/action_searchFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_searchFragment_to_recentFragment"
            app:destination="@id/recentFragment" />
    </fragment>
    <fragment
        android:id="@+id/matchDetailsFragment"
        android:name="com.example.loltracker.ui.MatchDetailsFragment"
        tools:layout="@layout/fragment_match_details" >
        <argument
            android:name="matchId"
            app:argType="string"    />
        <argument
            android:name="puuid"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/recentFragment"
        android:name="com.example.loltracker.ui.RecentFragment"
        android:label="fragment_recent"
        tools:layout="@layout/fragment_recent" />
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.loltracker.ui.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites" />
</navigation>