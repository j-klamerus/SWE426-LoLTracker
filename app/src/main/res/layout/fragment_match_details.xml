<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="matchInfo"
            type="com.example.loltracker.data.SummonerMatchData" />
    </data>

    <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Match header -->
        <!-- Use of databinding -->
        <TextView
            android:id="@+id/tvQueueType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{matchInfo.info.gameMode}"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMatchResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Victory"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="" />

        <!-- Focused player summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgChampionIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Champion icon"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSummonerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{matchInfo.info."
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChampionLane"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahri • Mid" />

                <TextView
                    android:id="@+id/tvKDA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 / 2 / 8" />

                <TextView
                    android:id="@+id/tvCS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="210 CS" />

                <TextView
                    android:id="@+id/tvGold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14,200 Gold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Summoner spells -->
        <TextView
            android:id="@+id/tvSpellsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Summoner Spells"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgSpell1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Summoner spell 1"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/imgSpell2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Summoner spell 2"
                android:src="@mipmap/ic_launcher" />
        </LinearLayout>

        <!-- Items -->
        <TextView
            android:id="@+id/tvItemsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Items"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/gridItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="4"
            android:rowCount="2">

            <ImageView
                android:id="@+id/item0"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 0"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 1"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 2"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 3"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 4"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 5"
                android:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/item6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="Item slot 6"
                android:src="@mipmap/ic_launcher" />
        </GridLayout>

        <!-- Extra stats -->
        <TextView
            android:id="@+id/tvStatsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Stats"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDamage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Damage: 24,300" />

        <TextView
            android:id="@+id/tvVisionScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vision Score: 28" />

        <!-- Blue team -->
        <TextView
            android:id="@+id/tvBlueTeamLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Blue Team"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBlueTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Red team -->
        <TextView
            android:id="@+id/tvRedTeamLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Red Team"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRedTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
</layout>