<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgRowChampionIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Champion icon"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowSummonerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SummonerName"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRowChampionRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ahri • Mid"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRowKDA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 / 2 / 8"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRowItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rowItem0"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 0"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 1"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 2"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 3"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 4"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 5"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/rowItem6"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:contentDescription="Item slot 6"
            android:src="@mipmap/ic_launcher" />
    </LinearLayout>

</LinearLayout>